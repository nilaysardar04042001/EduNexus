{
  "name": "edunexus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix Frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "node scripts/build-frontend.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "install:all": "npm --prefix Frontend install && npm --prefix backend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:migrate:turso": "npm --prefix backend run db:migrate:turso",
    "db:seed": "npm --prefix backend run db:seed",
    "db:studio": "npm --prefix backend run db:studio",
    "lint": "node Frontend/node_modules/oxlint/bin/oxlint -c .oxlintrc.json Frontend backend scripts",
    "preview": "npm --prefix Frontend run preview"
  }
}
